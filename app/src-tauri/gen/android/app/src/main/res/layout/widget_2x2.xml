<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/wd_bg_a">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
        <TextView android:id="@+id/lbl" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium" android:textSize="9sp" android:letterSpacing="0.2" android:textColor="@color/cy_amber"
            android:maxLines="2" android:ellipsize="end" android:layout_marginEnd="38dp" />
        <TextView android:id="@+id/big" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="serif" android:textStyle="italic" android:textSize="34sp" android:textColor="@color/cy_cream" android:maxLines="1" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="serif" android:textStyle="italic" android:textSize="16sp" android:textColor="@color/cy_cream" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textSize="10sp" android:textColor="@color/cy_dim" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <ImageView android:id="@+id/face" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="top|end"
        android:layout_marginTop="8dp" android:layout_marginEnd="8dp" android:scaleType="fitCenter" android:contentDescription="Cyph" />
</FrameLayout>
