<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/wd_bg_a">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
        <TextView android:id="@+id/lbl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textSize="9sp" android:letterSpacing="0.2" android:textColor="@color/cy_amber" android:maxLines="1" />
        <TextView android:id="@+id/excuse" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginEnd="44dp"
            android:fontFamily="serif" android:textStyle="italic" android:textSize="17sp" android:textColor="@color/cy_cream" android:maxLines="4" android:ellipsize="end" android:gravity="center_vertical" />
        <TextView android:id="@+id/btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/chip_bg"
            android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="6dp" android:paddingBottom="6dp"
            android:fontFamily="sans-serif-medium" android:textSize="11sp" android:letterSpacing="0.15" android:textColor="@color/cy_neon" android:text="I DON'T WANNA" />
    </LinearLayout>
    <ImageView android:id="@+id/face" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="top|end" android:layout_marginTop="8dp" android:layout_marginEnd="8dp" android:scaleType="fitCenter" android:contentDescription="Cyph" />
</FrameLayout>
